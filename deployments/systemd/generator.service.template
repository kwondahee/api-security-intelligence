[Unit]
Description=AETHER Traffic Generator (full testing)
After=network.target
Wants=network-online.target

[Service]
User=ubuntu
Group=ubuntu
Environment=PYTHONPATH=/home/ubuntu/aether-poc
WorkingDirectory=/home/ubuntu/aether-poc/generator
EnvironmentFile=/home/ubuntu/aether-poc/generator/config/generator.full.env
ExecStart=/home/ubuntu/aether-poc/generator/venv/bin/python /home/ubuntu/aether-poc/generator/run_generator.py --env /home/ubuntu/aether-poc/generator/config/generator.full.env
StandardOutput=journal
StandardError=journal
Restart=on-failure
RestartSec=5
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
