[Unit]
Description=AETHER Traffic Generator (one-shot demo)
After=network.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
Environment=PYTHONPATH=/home/ubuntu/api-security-intelligence
WorkingDirectory=/home/ubuntu/api-security-intelligence/generator
EnvironmentFile=/home/ubuntu/api-security-intelligence/generator/config/generator.demo.env
ExecStart=/home/ubuntu/api-security-intelligence/generator/venv/bin/python /home/ubuntu/api-security-intelligence/generator/run_generator.py --env /home/ubuntu/api-security-intelligence/generator/config/generator.demo.env
RemainAfterExit=no
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
