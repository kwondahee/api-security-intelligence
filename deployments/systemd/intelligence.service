[Unit]
Description=Aether Intelligence Framework
After=qdrant.service
Requires=qdrant.service

[Service]
Type=simple
WorkingDirectory=/home/ubuntu/api-security-intelligence/intelligence
ExecStart=/bin/bash /home/ubuntu/api-security-intelligence/intelligence/run_intelligence.sh
Restart=on-failure
RestartSec=10
StartLimitIntervalSec=0
StartLimitBurst=10
User=ubuntu

[Install]
WantedBy=multi-user.target
