[Unit]
Description=Milvus Vector Database
After=docker.service network.target
Requires=docker.service

[Service]
Type=simple
WorkingDirectory=/home/ubuntu/api-security-intelligence/intelligence
ExecStart=/bin/bash /home/ubuntu/api-security-intelligence/intelligence/run_milvus.sh
Restart=always
User=ubuntu

[Install]
WantedBy=multi-user.target
