[Unit]
Description=Milvus Vector Database (Docker Compose)
After=network.target docker.service
Requires=docker.service

[Service]
Type=simple
WorkingDirectory=/home/ubuntu/milvus
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
Restart=always
User=ubuntu
TimeoutStartSec=60
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
