[Unit]
Description=Qdrant Vector Database
After=docker.service network.target
Requires=docker.service

[Service]
Type=simple
WorkingDirectory=/home/ubuntu/api-security-intelligence/intelligence
ExecStart=/bin/bash /home/ubuntu/api-security-intelligence/intelligence/run_qdrant.sh
RestartSec=10
StartLimitIntervalSec=0
StartLimitBurst=10
User=root

[Install]
WantedBy=multi-user.target
